{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/autowarefoundation/autoware-index/main/schema/distribution.schema.json",
  "title": "Autoware Index distribution file",
  "description": "Schema for distributions/<distro>.yaml in the autoware-index registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ros_distro", "packages"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "ros_distro": {
      "type": "string",
      "description": "ROS 2 distribution name. MUST equal the filename stem (e.g. 'jazzy' for distributions/jazzy.yaml).",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "packages": {
      "type": "object",
      "description": "Registered packages keyed by package name.",
      "additionalProperties": { "$ref": "#/$defs/package" },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "governance", "tags", "maintainers", "ref"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "description": "Git remote URL for the package source."
        },
        "governance": {
          "type": "string",
          "enum": ["community", "foundation"]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "uniqueItems": true
        },
        "maintainers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/maintainer" }
        },
        "ref": { "$ref": "#/$defs/ref" }
      }
    },
    "maintainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email", "github"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "github": { "type": "string", "minLength": 1 }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "description": "What this package is registered as for this distro. Single ref per (package, distro).",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["tag", "sha", "branch"],
          "description": "tag/sha = pinned (immutable cells in history). branch = rolling (re-resolved by nightly sweeps)."
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
